{
  "name": "linksense-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 18731",
    "build": "next build && tsx scripts/cloudflare-output.ts",
    "start": "serve out --listen tcp://127.0.0.1:18731",
    "preview": "pnpm start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy": "pnpm build && cf deploy --prebuilt"
  },
  "dependencies": {
    "@orama/orama": "^3.1.16",
    "@orama/tokenizers": "^3.1.16",
    "@paper-design/shaders-react": "^0.0.63",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.0.10",
    "fumadocs-mdx": "13.0.7",
    "fumadocs-ui": "16.0.10",
    "gsap": "^3.15.1",
    "lucide-react": "^0.552.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.2",
    "@cloudflare/config": "0.26.0",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cf": "1.0.0-beta.17",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "14.2.4",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
